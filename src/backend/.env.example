# ── Database ──────────────────────────────────────────────
# Use "true" for SQLite (local dev). Omit or set "false" for PostgreSQL.
USE_SQLITE=true

# (Optional) Override the database URL entirely
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Authentication ────────────────────────────────────────
# CHANGE THIS in production! Use: just generate-jwt-secret
JWT_SECRET_KEY=project-butler-dev-secret-change-in-production

# ── AI / LLM ──────────────────────────────────────────────
# Set LLM_API_KEY to enable AI responses.
# Leave LLM_API_URL blank to use Gemini default:
#   https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
# Or point to any OpenAI-compatible endpoint (Ollama, LMStudio, Together, etc.):
#   https://localhost:11434/v1  (Ollama)
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=models/gemini-2.0-flash

# ── Strava Integration ────────────────────────────────────
# Register at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
