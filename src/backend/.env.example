# ── Database ──────────────────────────────────────────────
# Use "true" for SQLite (local dev). Omit or set "false" for PostgreSQL.
USE_SQLITE=true

# PostgreSQL (only used if USE_SQLITE is not set or is false)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fitness_tracker
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Authentication ────────────────────────────────────────
# CHANGE THIS in production! Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-in-production

# ── AI / LLM ──────────────────────────────────────────────
# OpenAI API key for Butler AI responses (optional — leave empty for offline mode)
OPENAI_API_KEY=

# ── Strava Integration ────────────────────────────────────
# Register at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_ACCESS_TOKEN=
